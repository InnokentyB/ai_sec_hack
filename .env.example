# App loopback port and exact browser origin (match SSH forwarded port).
LEDGER_PORT=8080
LEDGER_ORIGIN=http://127.0.0.1:8080
# Runtime data/key directory; provisioned on first start, never export private keys.
LEDGER_DATA=/data
# Private Compose receiver address, never published on the host.
LEDGER_RECEIVER_URL=http://receiver:8081
# Receiver's read-only application public-key provisioning file.
LEDGER_PUBLIC_KEYS=/trust/public.json
# Required project-specific subnet; verify it is unused on the target host.
LEDGER_SUBNET=10.231.117.0/28
# App writes only public role bindings to a dedicated shared volume.
LEDGER_PUBLIC_OUTPUT=/provision/public.json
